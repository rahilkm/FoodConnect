MONGODB_URI=mongodb://localhost:27017/foodconnect

# JWT - Change these in production!
JWT_ACCESS_SECRET=foodconnect-access-secret-change-in-production-please
JWT_REFRESH_SECRET=foodconnect-refresh-secret-change-in-production-please
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=30

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Seed
SEED_ADMIN_EMAIL=admin@foodconnect.local
SEED_DEFAULT_PASSWORD=Password123!

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=FoodConnect
